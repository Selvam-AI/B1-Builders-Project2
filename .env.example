APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite:///./data/fithub_ai.db
YOUTUBE_API_KEY=
SECRET_KEY=replace-with-local-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_ADMIN=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
AI_LLM_PROVIDER=ollama
AI_RECOMMENDER_MODE=llm
AI_ALLOW_MOCK_FALLBACK=true
MODEL=ollama/llama3
BASE_URL=http://localhost:11434
VIDEO_CURATOR_ENABLED=true
VIDEO_CACHE_TARGET_PER_CATEGORY=5
VIDEO_CACHE_MAX_PLAY_COUNT=3
VIDEO_CURATOR_INTERVAL_HOURS=24
